[Unit]
Description=Ncore / aurora control daemon
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ncore
Group=ncore
SupplementaryGroups=gpio dialout input video
WorkingDirectory=/home/ncore/ncore_daemon
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/ncore/ncore_daemon/.venv/bin/python -m ncore_daemon --config /home/ncore/ncore_daemon/config.yaml
Restart=always
RestartSec=3

# install.sh rewrites User/Group/paths for the account that runs it.

[Install]
WantedBy=multi-user.target
